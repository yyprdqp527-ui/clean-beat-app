<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Menu</title>
    <!-- Import Google Fonts Montserrat -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700&display=swap" rel="stylesheet">
    <style>
        /* Palette principale de l'application */
        :root{
            --teal-light: #A6D3DC;
            --teal-dark: #597176;
            --gold: #FDAE54;
            --peach: #F4C68D;
            --white: #ffffff;
        }

        body {
            font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, var(--teal-light) 0%, #f5f7f8 100%);
            min-height: 100vh;
            margin: 0;
        }

        /* Header menu réorganisé */
        .header-menu {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 4px;
            background: linear-gradient(135deg, var(--teal-light) 0%, var(--teal-dark) 100%);
            padding: 16px 20px;
            border-radius: 0 0 22px 22px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
            color: var(--teal-dark);
            position: relative;
        }

        .header-section {
            display:flex; align-items:center; gap:12px;
        }

        /* Burger menu */
        .burger-btn{
            width:44px; height:44px; display:inline-flex; align-items:center; justify-content:center; border-radius:10px; background: rgba(255,255,255,0.95); border: none; cursor:pointer; box-shadow: 0 6px 16px rgba(0,0,0,0.12);
        }
        .burger-lines{ width:22px; height:14px; display:flex; flex-direction:column; justify-content:space-between; }
        .burger-lines span{ display:block; height:2px; background:var(--teal-dark); border-radius:2px; }

        /* Side nav */
        .side-nav{ position:fixed; left:-280px; top:0; bottom:0; width:260px; background: linear-gradient(180deg, var(--teal-dark), var(--teal-light)); color:white; padding:22px; box-shadow: 4px 0 24px rgba(0,0,0,0.3); transition:left 0.28s ease; z-index:9999; }
        .side-nav.open{ left:0; }
        .side-nav h3{ margin:0 0 14px 0; font-size:18px; }
        .side-nav a{ display:block; color:white; text-decoration:none; padding:10px 12px; border-radius:8px; margin-bottom:8px; font-weight:700; }
        .side-nav a:hover{ background: rgba(255,255,255,0.08); }

        .avatar-square {
            width: 80px; height:80px; border-radius:14px; overflow:hidden; display:flex; align-items:center; justify-content:center;
            background: transparent; border: none; box-shadow: 0 12px 30px rgba(0,0,0,0.22);
            transition: transform 0.12s ease, box-shadow 0.12s ease;
        }

        .avatar-square img{ width:100%; height:100%; object-fit:cover; display:block; }
        .avatar-square:hover{
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 18px 40px rgba(0,0,0,0.28);
        }

        .player-info { display:flex; flex-direction:column; align-items:center; gap:4px; color:var(--teal-dark); font-weight:700; }

        /* Cadre léger autour des avatars */
        .avatar-square { border: 2px solid rgba(255,255,255,0.6); }

        /* Mini barre de santé pour chaque joueur */
        .mini-health-bar { width:110px; height:8px; background: rgba(0,0,0,0.05); border-radius:8px; overflow:hidden; box-shadow: inset 0 1px 4px rgba(0,0,0,0.04); }
        .mini-health-fill { height:100%; width:0%; background: linear-gradient(90deg, var(--gold), var(--peach)); border-radius:8px; transition: width 0.6s ease; }

        /* Ligne santé maison avec icône */
        .house-health-row { display:flex; align-items:center; gap:10px; }
        .house-health-icon { width:40px; height:40px; display:flex; align-items:center; justify-content:center; background: rgba(255,255,255,0.95); border-radius:10px; box-shadow: 0 8px 20px rgba(0,0,0,0.08); }
        .house-health-icon svg { width:20px; height:20px; fill: #FF6B81; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.08)); }
        @keyframes heart-pulse {
            0% { transform: scale(1); }
            25% { transform: scale(1.12); }
            40% { transform: scale(0.98); }
            60% { transform: scale(1.06); }
            100% { transform: scale(1); }
        }
        .house-health-icon.pulse { animation: heart-pulse 1.1s ease-in-out infinite; }

    </style>
</head>
<body>
{% set bar_width = house_bar_width|default(100)|int %}
{% if bar_width < 0 %}{% set bar_width = 0 %}{% endif %}
{% if bar_width > 100 %}{% set bar_width = 100 %}{% endif %}

<div class="header-menu" aria-label="Header principal">
    <div class="header-left" style="display:flex;align-items:center;gap:0;transform:translate(330px, 10px);">
        <div class="avatar-card" style="display:flex;flex-direction:column;align-items:center;gap:6px;background:transparent;padding:0;border-radius:8px;">
                <div class="avatar-square">
                    <img src="{{ player1_avatar_url if player1_avatar_url else url_for('static', filename='avatars/homme.png') }}" alt="Avatar {{ player1_name.split(' ')[0] if player1_name else 'Joueur 1' }}">
                </div>
                <div class="mini-health-bar" aria-hidden="true">
                    <div class="mini-health-fill" data-width="{{ player1_health|default(100)|int }}"></div>
                </div>
                <div style="display:flex;flex-direction:column;align-items:center;gap:2px;margin-top:2px;">
                    <div style="font-weight:800;color:var(--teal-dark);">{{ player1_name.split(' ')[0] if player1_name else 'Joueur 1' }}</div>
                    <div style="font-weight:700;color:#153036;">{{ player1_points|default(0) }} pts</div>
                </div>
        </div>
    </div>
    <div class="header-center" style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;">
        <div style="display:flex;flex-direction:column;align-items:center;gap:6px;">
            <div class="house-icon" aria-hidden="true" style="font-size:28px;">🏠</div>
            <div class="health-bar" style="width:180px;height:12px;">
                <div id="health-fill" class="health-fill" data-width="{{ house_progress|default(100)|int }}">{{ house_progress|default(100)|int }}%</div>
            </div>
            <div id="datetime" style="font-weight:700;color:var(--white);text-align:center;min-width:140px;margin-top:4px;font-size:0.95rem;"></div>
        </div>
    </div>
    <div class="header-right" style="display:flex;align-items:center;gap:0;transform:translate(-330px, 10px);">
        <div class="avatar-card" style="display:flex;flex-direction:column;align-items:center;gap:6px;background:transparent;padding:0;border-radius:8px;">
            <div class="avatar-square">
                <img src="{{ player2_avatar_url if player2_avatar_url else url_for('static', filename='avatars/homme.png') }}" alt="Avatar {{ player2_name.split(' ')[0] if player2_name else 'Joueur 2' }}">
            </div>
            <div class="mini-health-bar" aria-hidden="true">
                <div class="mini-health-fill" data-width="{{ player2_health|default(100)|int }}"></div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:2px;margin-top:2px;">
                <div style="font-weight:800;color:var(--teal-dark);">{{ player2_name.split(' ')[0] if player2_name else 'Joueur 2' }}</div>
                <div style="font-weight:700;color:#153036;">{{ player2_points|default(0) }} pts</div>
            </div>
        </div>
    </div>
</div>

    <script>
    // Script minimal pour initialiser la barre de santé, la date/heure et le bouton son
    document.addEventListener('DOMContentLoaded', function(){
        // Applique la largeur à la/aux barre(s) de santé
        document.querySelectorAll('.health-fill').forEach(function(fill){
            var w = fill.getAttribute('data-width');
            if(w !== null){ fill.style.width = w + '%'; }
        });

        // Mini-barres de santé des avatars
        document.querySelectorAll('.mini-health-fill').forEach(function(fill){
            var w = fill.getAttribute('data-width');
            if(w !== null){ fill.style.width = w + '%'; }
        });

        // Barre de santé de la maison (sous l'image)
        var houseFill = document.getElementById('house-health-fill');
        if(houseFill){
            var hw = houseFill.getAttribute('data-width');
            if(hw !== null){ houseFill.style.width = hw + '%'; }
            var hval = parseInt(hw, 10);
            if(!isNaN(hval) && hval >= 100){
                houseFill.textContent = '🎉 100%';
                // activer la pulsation du cœur
                var icon = document.querySelector('.house-health-icon');
                if(icon){ icon.classList.add('pulse'); }
            } else {
                // s'assurer que la classe pulse est retirée si non 100%
                var icon = document.querySelector('.house-health-icon');
                if(icon){ icon.classList.remove('pulse'); }
            }
        }

        var percent = parseInt("{{ house_progress|default(100)|int }}");
        if(!isNaN(percent) && percent >= 100){
            document.querySelectorAll('.health-fill').forEach(function(fill){ fill.textContent = '🎉 100%'; });
        }

        // Date et heure (format français)
        function updateDateTime(){
            var now = new Date();
            var date = now.toLocaleDateString('fr-FR', { weekday: 'short', day: '2-digit', month: 'short' });
            var time = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
            var el = document.getElementById('datetime');
            if(el){ el.textContent = date + ' • ' + time; }
        }
        updateDateTime();
        setInterval(updateDateTime, 60*1000);

        // Plus de contrôle sonore intégré — bouton supprimé
    });
    </script>

    <!-- Zone sous le header -->
    <div class="header-below-zone" style="display:flex;flex-direction:column;align-items:center;gap:12px;margin:18px 0 18px 0; width:100%;">
        <!-- Interface majeure : image 'newmaison.png' avec zones cliquables -->
        <div class="house-container" style="margin-bottom:8px;">
            <div class="house-center">
                <!-- Remise en place de la grande maison interactive (image + zones cliquables) -->
                <div class="house-image-wrapper" role="img" aria-label="Maison entière" style="width:420px;">
                    <svg class="svg-room" viewBox="0 0 334 484" style="width:100%; height:auto; display:block; border-radius:25px; overflow:hidden;">
                        <image href="{{ url_for('static', filename='images/newmaison.png') }}" width="334" height="484"/>

                        <!-- Zones cliquables : on retire les textes et les petits boutons visuels, on n'affiche que la zone mise en valeur -->
                        <a title="Salon" href="{{ url_for('categorie', cat='salon') }}">
                            <rect class="room-rect" x="10" y="120" width="100" height="90" />
                        </a>

                        <a title="Cuisine" href="{{ url_for('categorie', cat='cuisine') }}">
                            <rect class="room-rect" x="120" y="120" width="110" height="90" />
                        </a>

                        <a title="Zone Ados" href="{{ url_for('categorie', cat='chambre_ado') }}">
                            <rect class="room-rect" x="220" y="120" width="110" height="90" />
                        </a>

                        <a title="Pièce Bonus" href="{{ url_for('categorie', cat='piece_bonus') }}">
                            <rect class="room-rect" x="10" y="220" width="100" height="80" />
                        </a>

                        <a title="Chambre" href="{{ url_for('categorie', cat='chambre_parentale') }}">
                            <rect class="room-rect" x="110" y="220" width="110" height="80" />
                        </a>

                        <a title="Salle de Bain" href="{{ url_for('categorie', cat='salle_bain') }}">
                            <rect class="room-rect" x="240" y="220" width="110" height="80" />
                        </a>

                        <a title="Chambre Enfant" href="{{ url_for('categorie', cat='chambre') }}">
                            <rect class="room-rect" x="20" y="320" width="100" height="80" />
                        </a>

                        <a title="Chambre Bébé" href="{{ url_for('categorie', cat='chambre_bebe') }}">
                            <rect class="room-rect" x="150" y="320" width="110" height="80" />
                        </a>

                        <a title="Toilettes" href="{{ url_for('categorie', cat='toilettes') }}">
                            <rect class="room-rect" x="260" y="320" width="80" height="80" />
                        </a>

                        <a title="Garage" href="{{ url_for('categorie', cat='garage') }}">
                            <rect class="room-rect" x="10" y="380" width="160" height="120" />
                        </a>

                        <a title="Buanderie" href="{{ url_for('categorie', cat='buanderie') }}">
                            <rect class="room-rect" x="200" y="380" width="160" height="120" />
                        </a>
                    </svg>
                </div>

                    <!-- Barre de santé de la maison sous l'image, avec icône -->
                    <div style="width:420px;display:flex;flex-direction:column;align-items:center;gap:8px;margin-top:10px;">
                        <div style="font-weight:800;color:#1a2a3a;">{{ house_name if house_name else 'Ma Maison' }}</div>
                        <div class="house-health-row">
                            <div class="house-health-icon" title="Santé de la maison" aria-hidden="true">
                                <!-- Icône cœur (remplace maison) -->
                                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 6 3.99 4 6.5 4c1.74 0 3.41 1 4.5 2.09C12.09 5 13.76 4 15.5 4 18.01 4 20 6 20 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                                </svg>
                            </div>
                            <div class="health-bar" style="width:320px;height:12px;">
                                <div id="house-health-fill" class="health-fill" data-width="{{ house_progress|default(100)|int }}">{{ house_progress|default(100)|int }}%</div>
                            </div>
                        </div>
                    </div>

                <!-- house-name and container health-bar removed (kept compact header health-bar) -->
            </div>
        </div>

        <div class="maison-message-zone" style="min-height:32px;min-width:220px;max-width:420px;background:#f5f5f5;border-radius:10px;padding:10px 18px;color:#597176;font-size:1.08em;text-align:center;box-shadow:0 2px 8px #A6D3DC22; box-shadow: 0 2px 8px #A6D3DC22, inset 0 2px 18px #b3c9d6cc; position:relative;">
            <span style="display:block;font-weight:bold;color:#597176;font-size:1.08em;letter-spacing:0.5px;margin-bottom:2px;text-shadow:0 1px 0 #fff, 0 0 6px #A6D3DC77;">
                {{ house_name if house_name else 'Ma Maison' }} :
            </span>
            <span id="maison-message">Bienvenue dans la maison !</span>
        </div>
    </div>

</body>
